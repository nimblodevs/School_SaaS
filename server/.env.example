# Runtime mode and port; WEB_ORIGIN lists browser origins allowed by the API.
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Postgres — your database connection
DATABASE_URL="postgresql://user:password@localhost:5432/database?sslmode=require"
DATABASE_URL_POOLED="postgresql://user:password@localhost:5432/database?sslmode=require"

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3="https://storage.example.com"
AWS_ACCESS_KEY_ID="replace-with-storage-access-key"
AWS_SECRET_ACCESS_KEY="replace-with-storage-secret-key"
AWS_REGION="us-east-2"
S3_BUCKET="school-assets"

# Functions — serverless endpoints
# Deploy a neon function with the 'neon deploy' cli command or deploy a function from one of Neon's sample templates with 'neon bootstrap'

# Realtime — live SQL query subscriptions
NEON_REALTIME_URL="https://realtime.example.com/"
NEON_REALTIME_SECRET="replace-with-realtime-secret"

OTEL_SERVICE_NAME=school-saas-api
# Local Jaeger trace collector; start it with `docker compose up -d`.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Traces go to local Jaeger; metrics are scraped by Prometheus at this port.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_PROMETHEUS_HOST=0.0.0.0
OTEL_PROMETHEUS_PORT=9464
# Local-only Grafana password; set a unique value before exposing Grafana beyond localhost.
GRAFANA_ADMIN_PASSWORD=school-saas-local

# Authentication code lifetime, rate limits, proxy trust, and local upload directory.
LOGIN_OTP_MINUTES=3
AUTH_OTP_PEPPER=replace-with-a-stable-random-secret-at-least-32-characters
TRUST_PROXY=false
# false disables proxy trust; set a trusted hop count (for example 1) or proxy address/CIDR list only when deployed behind a proxy.
LOCAL_UPLOAD_DIR=./uploads
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_PER_IP=10
LOGIN_RATE_LIMIT_PER_IDENTIFIER=5
OTP_MAX_ATTEMPTS=10
OTP_RATE_LIMIT_PER_USER=10
OTP_RESEND_LIMIT=3
OTP_RESEND_WINDOW_MINUTES=10
# Pino log verbosity (for example: debug, info, warn, or error).
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# M-Pesa Configuration
# -----------------------------------------------------------------------------
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY="replace-with-mpesa-consumer-key"
MPESA_CONSUMER_SECRET="replace-with-mpesa-consumer-secret"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="replace-with-mpesa-passkey"
MPESA_CALLBACK_URL="https://yourdomain.com/mpesa/callback"
MPESA_INITIATOR_NAME="your_mpesa_initiator_name_here"
MPESA_SECURITY_CREDENTIAL="your_mpesa_security_credential_here"
MPESA_ALLOWED_IPS="your_allowed_ips_here"

# SMTP email delivery for email verification and password recovery.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="you@example.com"
SMTP_PASSWORD="replace-with-smtp-password"
AUTH_EMAIL_FROM="School SMIS <you@example.com>"

R2_ACCOUNT_ID=b6ab49efa60bca95a16eaba8b71091b1
R2_ACCESS_KEY_ID=a65ccbe8a49109505245c94de13d5f23
R2_SECRET_ACCESS_KEY=2d60da30314948d41bd211233cc6ea351c6440b7ca83c25c69afb2045198d9b9
R2_BUCKET_NAME=school-files
