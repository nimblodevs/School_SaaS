MPESA_B2C_TIMEOUT_URL="/api/mpesa/b2c/timeout"

# Transaction Status Credentials
# Callback URLs receive the result or timeout for transaction-status queries.
MPESA_TRANSACTIONSTATUS_RESULT_URL="/api/mpesa/transaction/status/callback"
MPESA_TRANSACTIONSTATUS_TIMEOUT_URL="/api/mpesa/transaction/status/timeout"

# mpesa Ratiba
# Callback URL for scheduled-payment notifications.
MPESA_RATIBA_CALLBACK_URL="/api/mpesa/ratiba/callback"

# Account Balance
# Queue-timeout and result callback URLs for account-balance queries.
MPESA_QUEUE_TIMEOUT_URL="/api/mpesa/account/balance/timeout"
MPESA_RESULT_URL="/api/mpesa/account/balance/result"

# MPESA_CERT_PATH=./cert/production.cer
# Put certificates inside:
# server/certs/
MPESA_CERT_PATH=certs/sandbox.cer 


